# Local development — copy to .env
NODE_ENV=development

# Postgres (docker compose, port 5433)
DATABASE_URL=postgres://tab402:tab402@localhost:5433/tab402
DATABASE_URL_TEST=postgres://tab402:tab402@localhost:5433/tab402_test
DATABASE_URL_E2E=postgres://tab402:tab402@localhost:5433/tab402_e2e
DATABASE_URL_BROWSER=postgres://tab402:tab402@localhost:5433/tab402_browser

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TAB402_MASTER_KEY=

# PayPal sandbox (Phase 0 day-1 tests, Phase 3)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# Sandbox only: accept unverified webhooks (e.g. the PayPal webhook simulator) when no PAYPAL_WEBHOOK_ID is set
PAYPAL_WEBHOOK_SKIP_VERIFY=0

# AI (spend guard, agents, demo /v1/chat). Without a key the guard and demo LLM use labelled mocks.
ANTHROPIC_API_KEY=
# Optional overrides; defaults claude-haiku-4-5 and 3000 ms. On timeout the guard asks a human.
GUARD_MODEL=
GUARD_TIMEOUT_MS=

# Local service URLs
TAB402_API_URL=http://localhost:4000
# Web app (approval pages, wallet return URLs)
WEB_URL=http://localhost:3000
API_PORT=4000
MCP_PORT=4100
DEMO_SELLERS_PORT=4200

# Local demo API keys (./demo/setup.sh fills them). Seller keys start t402_sk_, buyer keys t402_bk_:
#   node -e "console.log('t402_sk_'+require('crypto').randomBytes(32).toString('base64url'))"
DEMO_SELLER_API_KEY=
DEMO_BUYER_API_KEY=
DEMO_SELLERS_URL=http://localhost:4200
# mock (default without ANTHROPIC_API_KEY) or anthropic
DEMO_LLM=mock

# Web app auth (Better Auth). Secret: 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MCP_URL=http://localhost:4100/mcp

# AG Studio (dashboard). Without a key it runs with a watermark. 45-day trial: https://www.ag-grid.com/studio/license-pricing/?tab=trial
AG_STUDIO_LICENSE_KEY=

# Optional model overrides (defaults: claude-sonnet-5-5). ONBOARDING_MODEL=mock forces the keyword
# stand-in (browser tests); the onboarding agent also falls back to it without ANTHROPIC_API_KEY.
ONBOARDING_MODEL=
REVENUE_AGENT_MODEL=

# Web Push for approvals and seller alerts: npx tsx scripts/vapid.ts >> .env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@tab402.dev

# Settlement runner. Locally the worker settles tabs with pg-boss (default). On Render the
# tab402-settlement workflow does it, started by the tab402-settle cron job (see render.yaml).
SETTLEMENT_RUNNER=
# Only for starting workflow runs (the cron job, or `pnpm --filter @tab402/workflows trigger`)
RENDER_API_KEY=
WORKFLOW_SLUG=tab402-settlement
