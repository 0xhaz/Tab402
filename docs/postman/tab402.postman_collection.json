{
  "info": {
    "name": "Tab402 API",
    "description": "x402 facilitator for fiat tabs, seller and buyer APIs. Generated from /openapi.json by scripts/postman/build.ts — do not edit by hand.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Walkthrough: wallet → 402 → paid → settled",
      "description": "Run in order. The paid call (step 5) needs an ES256-signed voucher, which Postman's sandbox can't produce: run `npx tsx --env-file=.env scripts/demo/pay.ts` or ask Claude through the Tab402 MCP server, then continue with step 6.",
      "item": [
        {
          "name": "1. Facilitator: supported schemes",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/supported"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tab scheme', () => pm.expect(pm.response.json().kinds[0].scheme).to.eql('tab'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Buyer: start PayPal wallet setup (vault without purchase)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{buyerKey}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/wallet/setup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"returnUrl\": \"{{webUrl}}/wallet\",\n  \"cancelUrl\": \"{{webUrl}}/wallet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Open the returned approval URL in a browser and approve with a PayPal sandbox buyer."
          }
        },
        {
          "name": "3. Seller: register a priced route",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sellerKey}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/endpoints",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoints\": [\n    {\n      \"method\": \"POST\",\n      \"url\": \"{{sellerUrl}}/v1/summarize\",\n      \"pricing\": \"fixed\",\n      \"price\": \"10000\",\n      \"description\": \"Summarize text\",\n      \"category\": \"llm\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4. Agent: call without paying → 402 + PAYMENT-REQUIRED",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{sellerUrl}}/v1/summarize",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Tab402 lets agents pay per call.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('402 Payment Required', () => pm.response.to.have.status(402));",
                  "const required = JSON.parse(atob(pm.response.headers.get('PAYMENT-REQUIRED')));",
                  "pm.test('tab scheme offered', () => pm.expect(required.accepts.map(a => a.scheme)).to.include('tab'));",
                  "console.log('PAYMENT-REQUIRED', required);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. (SDK) Pay and call — see folder description",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/health",
            "description": "Placeholder: run scripts/demo/pay.ts."
          }
        },
        {
          "name": "6. Directory: find the route",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/directory?q=summarize"
          }
        },
        {
          "name": "7. Discovery: the seller's /.well-known/x402",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{sellerUrl}}/.well-known/x402"
          }
        },
        {
          "name": "8. Seller: events (charge, settlement, payout)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sellerKey}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/events?limit=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.response.to.have.status(200));",
                  "console.log(pm.response.json().data.map(e => e.type));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
