              "path": [
                "wallet",
                "complete"
              ],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mandateId\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Top up the prepaid balance from the saved wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
